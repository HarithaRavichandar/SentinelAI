# SentinelAI Environment Configuration Template
# Copy this file to '.env' and customize for your local setup.
# WARNING: Do NOT commit your actual '.env' file containing real secrets to version control.

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=True

# Reproducibility
RANDOM_SEED=42

# Storage & Data Paths
DATA_RAW_DIR=data/raw
DATA_INTERIM_DIR=data/interim
DATA_PROCESSED_DIR=data/processed
DATA_SYNTHETIC_DIR=data/synthetic
MODELS_DIR=models

# Service Configuration (Placeholders for future phases)
API_HOST=127.0.0.1
API_PORT=8000
APP_PORT=8501
SECRET_KEY=change-this-to-a-secure-random-key-in-production
GEMINI_MODEL=your-gemini-model
GEMINI_API_KEY=your-gemini-api-key