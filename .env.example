# ==============================================================================
# SentinelAI Environment Configuration Template
# Copy this file to '.env' at the project root for local backend execution.
# For frontend configuration, set VITE_API_BASE in frontend/.env or shell env.
#
# NOTE: Never commit your actual '.env' containing private credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Machine Learning Model Selection
# ------------------------------------------------------------------------------
# Selects which Random Forest model and preprocessor artifacts to load:
#   - 'legacy' (default): data/models/random_forest_balanced.pkl
#   - 'fresh':            data/models_fresh/random_forest_fresh.pkl
SENTINELAI_MODEL_VERSION=legacy

# ------------------------------------------------------------------------------
# 2. Decision Engine & Triage Policy Mode
# ------------------------------------------------------------------------------
# Enable or disable the experimental validation-calibrated two-stage decision policy.
#   - 'false' (default): Legacy deterministic single-stage triage logic.
#   - 'true':  Experimental two-stage policy using frozen validation thresholds
#              (theta_low=0.20, theta_high=0.70) and fresh class reliability weights.
SENTINELAI_TWO_STAGE_TRIAGE=false

# ------------------------------------------------------------------------------
# 3. Database Persistence (SQLite)
# ------------------------------------------------------------------------------
# Path to SQLite database file for alert persistence.
# If omitted or empty, defaults to 'data/alerts.db'.
SENTINELAI_DB_PATH=data/alerts.db

# ------------------------------------------------------------------------------
# 4. Laya Conversational Assistant & Natural Language Explanations
# ------------------------------------------------------------------------------
# Select the active LLM provider for conversational chat and triage explanations:
#   - 'groq'   (default): Requires GROQ_API_KEY and GROQ_MODEL
#   - 'gemini': Requires GEMINI_API_KEY and GEMINI_MODEL
#
# If credentials are missing or the provider fails, SentinelAI automatically
# falls back to deterministic static templates (source="template").
# NOTE: Laya explanations are purely advisory and do NOT make triage or routing decisions.
LLM_PROVIDER=groq

# --- Groq Provider Configuration ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
# Optional Groq API endpoint override (defaults to https://api.groq.com/openai/v1/chat/completions)
GROQ_API_ENDPOINT=https://api.groq.com/openai/v1/chat/completions
# Timeout in seconds for Groq API requests (default: 15)
GROQ_TIMEOUT_SECONDS=15

# --- Gemini Provider Configuration ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
# Timeout in seconds for Gemini API requests (default: 15)
GEMINI_TIMEOUT_SECONDS=15

# ------------------------------------------------------------------------------
# 5. Frontend Environment (Optional / frontend/.env)
# ------------------------------------------------------------------------------
# Base URL of the running SentinelAI FastAPI backend (default: http://127.0.0.1:8000)
VITE_API_BASE=http://127.0.0.1:8000

# ------------------------------------------------------------------------------
# 6. Server & Network Bindings (FastAPI / Uvicorn)
# ------------------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO
DEBUG=False
