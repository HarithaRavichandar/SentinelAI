# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
.venv*/
**/.venv*/
**/venv*/

# Frontend dependencies and build outputs
node_modules/
**/node_modules/
frontend/node_modules/
frontend/dist/
.pnpm-store/

# Environment variables and secrets
.env
.env.*
!.env.example
*.pem
*.key
*.cert
secrets/

# Datasets and data dumps (do not track large data in Git)
data/raw/*
data/interim/*
data/processed/*
data/synthetic/*
!**/data/**/.gitkeep
*.csv
*.tsv
*.parquet
*.feather
*.h5
*.hdf5
*.arrow
*.tar.gz
*.zip
*.7z
*.npy
*.npz

# Model weights and serialized artifacts
models/*
!**/models/**/.gitkeep
*.pkl
*.pickle
*.joblib
*.pt
*.pth
*.onnx
*.bin
*.model

# Cache, testing, and coverage
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.cover
*.py,cover

# Jupyter Notebook checkpoints
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# Local databases
*.db
*.sqlite
*.sqlite3

# Logs
logs/
*.log

# OS-specific files
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# IDE and editor settings
.idea/
.vscode/
.gemini/
**/.gemini/
*.swp
*.swo
*~

# Python, scratch, and pytest temporary files
__pycache__/
*.py[cod]
.pytest_cache/
.pytest_tmp/
tmp/
scratch/
**/scratch/
